---
import { Picture } from 'astro:assets';
import mailImage from '#assets/mail.png'; // Image is 1600x900
import Layout from '#layouts/Layout.astro';
import '#styles/pages/contact.css';
---

<Layout
	title="contact - janis.me"
	heading={{ eyebrow: 'Contact', title: 'Say hi', subtitle: 'I will answer on bluesky. Good luck with mails.' }}
	back={{ href: '/', label: 'Back home' }}
>
	<div class="contact">
		<p>
			You can reach me via:
			<Picture
				src={mailImage}
				alt="My email. Sorry, only an image. You can reach out to me on linkedin if you need to."
			/>
			or hit me up on <a href="https://bsky.app/profile/janis.me" target="_blank" rel="noopener">Bluesky</a>
		</p>
	</div>
</Layout>
