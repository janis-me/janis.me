---
import type { HTMLAttributes } from 'astro/types';
import './logo.css';

type Props = HTMLAttributes<'svg'> & { title?: string };

const { title = 'janis.me logo', class: className, ...attrs } = Astro.props;
---

<svg viewBox="0 0 384 384" role="img" class:list={['logo', className]} {...attrs}>
	<title>{title}</title>
	<path d="M0 0H384V384H0Z" />
	<path d="M0 40L384 62V384H0Z" />
	<path d="M0 117L384 92V384H0Z" />
	<path d="M0 154L384 186V384H0Z" />
	<path d="M0 254L384 228V384H0Z" />
</svg>
