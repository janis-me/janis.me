---
import type { BlogProps } from '$content.config';
import Layout from '$layouts/Layout.astro';
import './Blog.css';

interface Props {
	content: BlogProps;
}

const { content } = Astro.props;
const { title, description, createdAt, updatedAt, tags } = content;

const createdDate = new Date(createdAt);
const updatedDate = updatedAt != createdAt ? new Date(updatedAt) : null;

const eyebrow = [
	createdDate.toLocaleDateString(),
	updatedDate && `updated ${updatedDate.toLocaleDateString()}`,
	tags?.join(', '),
]
	.filter(Boolean)
	.join(' · ');
---

<Layout
	title={`${title} - janis.me`}
	description={description ?? 'janis.me/blog - a blog made for programming, probably full of food'}
	heading={{ eyebrow, title, subtitle: description }}
	back={{ href: '/blog/', label: 'See all posts' }}
>
	<article class="post">
		<slot />
		<p>~ Cheers</p>
	</article>
</Layout>
