---
import { getCollection } from 'astro:content';
import PostCard from '#components/PostCard/PostCard.astro';
import Layout from '#layouts/Layout.astro';
import '#styles/pages/blog.css';

const posts = await getCollection('blog', ({ data }) => data.published === true);

posts.sort((a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime());

const years = Map.groupBy(posts, post => post.data.createdAt.getFullYear());
---

<Layout
	title="blog - janis.me"
	heading={{
		eyebrow: 'Blog',
		title: 'Mostly programming and some food',
		subtitle: 'I post whenever I wrote a nice piece of code',
	}}
	back={{ href: '/', label: 'Back home' }}
	container="bare"
>
	<div class="posts">
		{[...years].map(([year, yearPosts]) => (
			<section class="year" aria-labelledby={`year-${year}`}>
				<header class="year-divider">
					<h2 id={`year-${year}`}>{year}</h2>
					<span set:text={`${yearPosts.length} ${yearPosts.length === 1 ? 'post' : 'posts'}`} />
				</header>
				{yearPosts.map(post => (
					<PostCard
						href={`/blog/${post.id}`}
						title={post.data.title}
						date={post.data.createdAt}
						tags={post.data.tags}
					/>
				))}
			</section>
		))}
	</div>
</Layout>
