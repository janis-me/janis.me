---
import LinkCard from '#components/LinkCard/LinkCard.astro';
import './AboutHero.css';

const cards = [
	{ href: '/blog', label: 'Read the blog' },
	{ href: '/cv', label: 'See the CV' },
	{ href: '/contact', label: 'Say hi' },
];
---

<div class="about-hero">
	<section class="tile" data-span="4">
		<h2>About</h2>
		<p>
			I build complex, data-heavy web apps across the whole stack, from the database to (mostly) pixel-perfect UI.
			Always looking for new ways to make things happen.
		</p>
	</section>

	<section class="tile stat" data-span="2">
		<strong><span class="strikethrough">7</span> <span class="strikethrough">8</span> 9</strong>
		<p>years of programming professionally</p>
	</section>

	<section class="tile accent" data-span="3">
		<h2>Now</h2>
		<p>
			Conversational AI at <a href="https://cognigy.com" target="_blank" rel="noopener">Cognigy</a>, the agent-based CX
			platform. Recently acquired by <a href="https://www.nice.com/" target="_blank" rel="noopener">NiCE</a> for $955M.
		</p>
	</section>

	<section class="tile" data-span="3">
		<h2>Off the clock</h2>
		<p>Living on the countryside with two cats. Playing bass guitar, much to the dismay of my girlfriend.</p>
	</section>

	<section class="tile" data-span="6">
		<h2>Before</h2>
		<ul>
			<li>
				<a href="https://divecae.com" target="_blank" rel="noopener">Dive</a>: cloud-native CAE. Thermofluid simulations
				on cloud GPUs, right in the browser, with WASM, WebGL and WebSockets.
			</li>
			<li>
				<a href="https://sms-group.com" target="_blank" rel="noopener">SMS Group</a>: physical models in the cloud, ML
				predictions for steel casting.
			</li>
		</ul>
	</section>

	<section class="tile" data-span="4">
		<h2>Open source</h2>
		<ul>
			<li>
				<a href="https://surimi.dev" target="_blank" rel="noopener">surimi</a>: type-safe CSS in TypeScript. This site
				runs on it.
			</li>
			<li>
				<a href="https://handlery.dev" target="_blank" rel="noopener">handlery.dev</a>: typed event handling with
				decorators.
			</li>
			<li><a href="https://caddly.roulz.com/" target="_blank" rel="noopener">Caddly</a>: config builder for Caddy.</li>
		</ul>
	</section>

	<section class="tile" data-span="2">
		<h2>Side quests</h2>
		<ul>
			<li><a href="https://licensephobia.com" target="_blank" rel="noopener">Licensephobia</a> (WIP)</li>
			<li><a href="https://youtube.com/@roulzhq" target="_blank" rel="noopener">ROULZ</a> on YouTube</li>
		</ul>
	</section>

	{cards.map(card => <LinkCard {...card} data-span="2" />)}
</div>
