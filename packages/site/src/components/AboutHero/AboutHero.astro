---
import Card from '#components/Card/Card.astro';
import Link from '#components/Link/Link.astro';
import LinkCard from '#components/LinkCard/LinkCard.astro';
import './AboutHero.css';

const cards = [
	{ href: '/blog', label: 'Read the blog' },
	{ href: '/cv', label: 'See the CV' },
	{ href: '/contact', label: 'Say hi' },
];
---

<div class="about-hero">
	<Card title="About" data-span="4">
		<p>
			Hey! This website is about writing high-quality code, building apps, cooking, cats.. but mostly CSS and
			typescript. I'm Janis, a full-stack dev from Germany.
		</p>
	</Card>

	<Card variant="paper" title="10+" data-span="2">
		<p>Years of programming professionally. +3 coding unprofessionally.</p>
	</Card>

	<Card title="Currently" variant="highlight" data-span="3">
		<p>
			Engineering at <Link href="https://elevenlabs.io">ElevenLabs</Link>. Teaching machines to sing, handling a lot of
			data and automating the hell out of everyday work.
		</p>
	</Card>

	<Card title="Off the clock" data-span="3">
		<p>Living on the countryside with two cats. Playing bass guitar, much to the dismay of my neighbours.</p>
	</Card>

	<Card title="Before" data-span="6">
		<ul>
			<li>
				Conversational AI at <Link href="https://cognigy.com">Cognigy</Link>, the agent-based CX platform. Recently
				acquired for $1bn.
			</li>
			<li>
				<Link href="https://divecae.com">Dive</Link>: cloud-native thermofluid simulations. CAE right in the browser,
				with WASM, WebGL and many, many equations.
			</li>
			<li>
				<Link href="https://sms-group.com">SMS Digital</Link>: physical models in the cloud, ML predictions for
				steelmaking.
			</li>
		</ul>
	</Card>

	<Card title="Open source" data-span="4">
		<ul>
			<li>
				<Link href="https://surimi.dev">surimi</Link>: type-safe, zero-runtime CSS in TypeScript. It's what powers this
				site.
			</li>
			<li><Link href="https://handlery.dev">handlery.dev</Link>: typed event handling with decorators.</li>
			<li><Link href="https://caddly.roulz.com/">Caddly</Link>: config builder for Caddy.</li>
		</ul>
	</Card>

	<Card title="Side quests" data-span="2">
		<ul>
			<li><Link href="https://licensephobia.com">Licensephobia</Link> (WIP)</li>
			<li><Link href="https://youtube.com/@janis-me">janis.me</Link> on YouTube</li>
			<li>
				Painting the
				<Link href="https://warhammer40k.fandom.com/wiki/Adeptus_Mechanicus">Adeptus Mechanicus</Link>
			</li>
		</ul>
	</Card>

	{cards.map(card => <LinkCard {...card} data-span="2" />)}
</div>
