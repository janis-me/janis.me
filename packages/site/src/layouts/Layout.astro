---
import openSansWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import '#styles/index.css';
import '#styles/code.css';
import './Layout.css';
import Header from '#components/Header/Header.astro';
import Notice from '#components/Notice/Notice.astro';
import PageBar, { type Props as PageBarProps } from '#components/PageBar/PageBar.astro';
import PageHead, { type Props as PageHeadProps } from '#components/PageHead/PageHead.astro';

import SocialIcons from '#components/SocialIcons/SocialIcons.astro';
import { themeNames } from '#styles/theme.css.ts';

interface Props {
	/** Document `<title>`. */
	title: string;
	description?: string | undefined;
	heading: PageHeadProps;
	back?: PageBarProps['back'];
	container?: 'framed' | 'bare';
}

const { title, description, heading, back, container = 'framed' } = Astro.props;

const metaDescription = description || 'Janis Jansen - Fullstack dev & creator';
---

<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<meta name="generator" content={Astro.generator}>
		<meta name="description" content={metaDescription}>
		<meta
			name="keywords"
			content="Janis Jansen, fullstack, developer Düsseldorf, softwareentwickler Düsseldorf, carnageous, janis-me, janis.me"
		>
		<meta name="robots" content="index, follow, max-snippet:120, max-image-preview:large">
		<link rel="sitemap" href="/sitemap-index.xml">
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
		<link rel="alternate" type="application/rss+xml" title="janis.me blog" href="/rss.xml">

		<title>{title}</title>

		<link rel="preload" as="font" type="font/woff2" href={openSansWoff2} crossorigin="anonymous">

		<script is:inline define:vars={{ themeNames }}>
		let stored = null;
		try {
			stored = localStorage.getItem('theme');
		} catch {}
		document.documentElement.dataset.theme = themeNames.includes(stored)
			? stored
			: matchMedia('(prefers-color-scheme: dark)').matches
				? 'dark'
				: 'light';
		</script>
	</head>

	<body>
		<Header />
		<PageHead {...heading} />

		<main class:list={['frame', container]}>
			<PageBar back={back} />
			<slot />
		</main>

		<Notice />

		<footer class="site-footer">
			<p>Thanks for being here! <span class="extra">Yeah. No cookie banner, no TOS. Crazy.</span></p>
			<div class="socials">
				<SocialIcons />
			</div>
		</footer>
	</body>
</html>
