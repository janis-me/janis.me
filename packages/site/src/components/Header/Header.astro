---
import Logo from '#components/Logo/logo.astro';
import { themeNames } from '#styles/theme.css.ts';
import './Header.css';

const options = themeNames.map(name => ({ value: name, label: name }));

const pageLinks = [
	{ url: '', label: 'Home' },
	{ url: 'blog', label: 'Blog' },
	{ url: 'cv', label: 'CV' },
	{ url: 'contact', label: 'Contact' },
] as const;

const currentPage = Astro.url.pathname.split('/')[1] ?? '';
---

<header class="site-header">
	<a href="/" class="home"><Logo title="janis.me - home" /></a>

	<nav class="site-nav">
		{pageLinks.map(link => (
			// biome-ignore lint/a11y/useAnchorContent: `set:text` fills it; children would get formatter whitespace.
			<a
				href={link.url ? `/${link.url}/` : '/'}
				aria-current={link.url === currentPage ? 'page' : undefined}
				set:text={link.label}
			/>
		))}
	</nav>

	<details class="theme-picker">
		<summary title="Theme">
			<span class="visually-hidden">Theme:</span>
			{options.map(option => (
				<span class="theme-label" data-for={option.value}>
					{option.label}
				</span>
			))}
		</summary>
		<menu>
			{options.map(option => (
				<li>
					<button type="button" value={option.value} aria-pressed="false">
						{option.label}
					</button>
				</li>
			))}
		</menu>
	</details>
</header>

<script>
const STORAGE_KEY = 'theme';
const root = document.documentElement;
const picker = document.querySelector<HTMLDetailsElement>('.theme-picker');

if (picker) {
	const buttons = [...picker.querySelectorAll<HTMLButtonElement>('menu button')];

	const sync = () => {
		const current = root.dataset.theme ?? '';
		for (const button of buttons) button.setAttribute('aria-pressed', String(button.value === current));
	};

	const apply = (theme: string) => {
		root.dataset.theme = theme;
		localStorage.setItem(STORAGE_KEY, theme);
		sync();
	};

	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
		if (localStorage.getItem(STORAGE_KEY)) return;
		root.dataset.theme = event.matches ? 'dark' : 'light';
		sync();
	});

	const switchTo = (theme: string) => {
		const update = () => {
			apply(theme);
			picker.open = false;
		};
		if (!document.startViewTransition) return update();
		root.toggleAttribute('data-theme-switch', true);
		document.startViewTransition(update).finished.finally(() => root.removeAttribute('data-theme-switch'));
	};

	for (const button of buttons) {
		button.addEventListener('click', () => {
			switchTo(button.value);
			picker.querySelector('summary')?.focus();
		});
	}

	document.addEventListener('click', event => {
		if (picker.open && !picker.contains(event.target as Node)) picker.open = false;
	});

	picker.addEventListener('keydown', event => {
		if (event.key === 'Escape' && picker.open) {
			picker.open = false;
			picker.querySelector('summary')?.focus();
		}
	});

	sync();
}
</script>
