---
import SocialIcons from '$components/SocialIcons/SocialIcons.astro';
import Layout from '$layouts/Layout.astro';
---

<Layout title="cv - janis.me" raw hideBanner>
  <div class="cl">
    <h2 class="title section">
      Janis Jansen
      <span class="title__right raw-only">
        <a href="mailto:mail@janis.me">mail@janis.me</a>
        <SocialIcons />
      </span>
    </h2>
    <div class="content">
      <!--  -->
    </div>
  </div>
</Layout>

<style lang="scss">
  @use '$styles/globals' as *;

  .content {
    padding: themed('size-8') themed('size-16');
  }

  .title {
    grid-area: title;
    padding: themed('size-8') themed('size-16');
    border-top: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: themed('background');
    border-bottom: 1px solid themed('gray-8');
    border-collapse: collapse;
    margin: 0;

    &__right {
      font-size: 0.8rem;
      display: flex;
      gap: themed('size-12');
    }
  }
</style>
