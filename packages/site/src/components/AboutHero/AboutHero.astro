---
import LinkCard from '#components/LinkCard/LinkCard.astro';
import './AboutHero.css';

const cards = [
	{ href: '/blog', label: 'Read the blog' },
	{ href: '/cv', label: 'See the CV' },
	{ href: '/contact', label: 'Say hi' },
];
---

<div class="about-hero">
	<section class="tile" data-span="4">
		<h2>About</h2>
		<p>
			Hey! This website is about writing high-quality code, building apps, cooking, cats and a lot of CSS and
			typescript. I'm Janis, a full-stack dev from Germany.
		</p>
	</section>

	<section class="tile stat" data-span="2">
		<strong><span class="strikethrough">8</span> <span class="strikethrough">9</span> 10</strong>
		<p>years of professional experience. Oof.</p>
	</section>

	<section class="tile accent" data-span="3">
		<h2>Currently</h2>
		<p>
			Engineering at <a href="https://elevenlabs.io" target="_blank" rel="noopener">ElevenLabs</a>. Teaching machines to
			sing, handling a lot of data and automating the hell out of everyday work.
		</p>
	</section>

	<section class="tile" data-span="3">
		<h2>Off the clock</h2>
		<p>Living on the countryside with two cats. Playing bass guitar, much to the dismay of my neighbours.</p>
	</section>

	<section class="tile" data-span="6">
		<h2>Before</h2>
		<ul>
			<li>
				Conversational AI at <a href="https://cognigy.com" target="_blank" rel="noopener">Cognigy</a>, the agent-based
				CX platform. Recently acquired for $1bn.
			</li>
			<li>
				<a href="https://divecae.com" target="_blank" rel="noopener">Dive</a>: cloud-native thermofluid simulations. CAE
				right in the browser, with WASM, WebGL and many, many equations.
			</li>
			<li>
				<a href="https://sms-group.com" target="_blank" rel="noopener">SMS Digital</a>: physical models in the cloud, ML
				predictions for steelmaking.
			</li>
		</ul>
	</section>

	<section class="tile" data-span="4">
		<h2>Open source</h2>
		<ul>
			<li>
				<a href="https://surimi.dev" target="_blank" rel="noopener">surimi</a>: type-safe, zero-runtime CSS in
				TypeScript. It's what powers this site.
			</li>
			<li>
				<a href="https://handlery.dev" target="_blank" rel="noopener">handlery.dev</a>: typed event handling with
				decorators.
			</li>
			<li><a href="https://caddly.roulz.com/" target="_blank" rel="noopener">Caddly</a>: config builder for Caddy.</li>
		</ul>
	</section>

	<section class="tile" data-span="2">
		<h2>Side quests</h2>
		<ul>
			<li><a href="https://licensephobia.com" target="_blank" rel="noopener">Licensephobia</a> (WIP)</li>
			<li><a href="https://youtube.com/@janis-me" target="_blank" rel="noopener">janis.me</a> on YouTube</li>
			<li>
				Painting the
				<a href="https://warhammer40k.fandom.com/wiki/Adeptus_Mechanicus" target="_blank" rel="noopener"
					>Adeptus Mechanicus</a
				>
			</li>
		</ul>
	</section>

	{cards.map(card => <LinkCard {...card} data-span="2" />)}
</div>
